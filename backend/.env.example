PORT=3001
NODE_ENV=development

# Active: Supabase PostgreSQL (Session pooler, IPv4). Copy both URLs from
# Supabase Dashboard > Connect; URL-encode the DB password.
# Replace PROJECT_REF and ENCODED_PASSWORD with dashboard values.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@REPLACE-WITH-SESSION-POOLER-HOST:5432/postgres?sslmode=require&schema=public"
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@REPLACE-WITH-SESSION-POOLER-HOST:5432/postgres?sslmode=require&schema=public"

# Legacy local MySQL (nonaktif). Use --config prisma.mysql.config.js if restored.
# DATABASE_URL="mysql://root:@127.0.0.1:3306/inpatient_db"

# Auth (JWT). Generate the secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-chars"
JWT_EXPIRES_IN=8h
