# Base URL API Backend (Lokal default port 3001, atau URL Vercel/Railway saat production)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Strict Backend Mode:
# "true"  = 100% data riil dari backend, fallback mock dinonaktifkan (disarankan untuk testing integrasi)
# "false" = Mengizinkan data mock fallback jika server backend mati
NEXT_PUBLIC_STRICT_BACKEND=true
